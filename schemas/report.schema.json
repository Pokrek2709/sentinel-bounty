{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SentinelBountyReport",
  "type": "object",
  "required": [
    "report_id",
    "target_id",
    "program_name",
    "generated_at",
    "executive_summary",
    "findings_summary",
    "findings"
  ],
  "properties": {
    "report_id": { "type": "string" },
    "target_id": { "type": "string" },
    "session_id": { "type": "string" },
    "program_name": { "type": "string" },
    "generated_at": { "type": "string", "format": "date-time" },
    "executive_summary": { "type": "string" },
    "findings_summary": {
      "type": "object",
      "properties": {
        "critical": { "type": "integer" },
        "high": { "type": "integer" },
        "medium": { "type": "integer" },
        "low": { "type": "integer" },
        "informational": { "type": "integer" },
        "total": { "type": "integer" }
      }
    },
    "template": { "type": "string", "description": "Platform template the report was rendered with (generic reports omit this field)." },
    "scope_details": { "type": "object" },
    "attack_surface_summary": { "type": "object" },
    "findings": {
      "type": "array",
      "items": { "$ref": "finding.schema.json" }
    },
    "groups": {
      "type": "array",
      "description": "Findings grouped by asset_id (generic reports only; platform-template JSON omits this field). Groups are ordered by asset_id ascending; findings inside a group by severity then finding_id. The flat findings array carries the same findings in grouped order.",
      "items": {
        "type": "object",
        "properties": {
          "asset_id": { "type": "string" },
          "findings_count": { "type": "integer" },
          "findings_summary": {
            "type": "object",
            "properties": {
              "critical": { "type": "integer" },
              "high": { "type": "integer" },
              "medium": { "type": "integer" },
              "low": { "type": "integer" },
              "informational": { "type": "integer" },
              "total": { "type": "integer" }
            }
          },
          "findings": {
            "type": "array",
            "items": { "$ref": "finding.schema.json" }
          }
        }
      }
    },
    "methodology": { "type": "string" }
  }
}
