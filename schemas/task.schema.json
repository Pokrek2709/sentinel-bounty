{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SentinelBountyTask",
  "type": "object",
  "required": ["task_id", "session_id", "target_id", "task_type", "status", "created_at"],
  "properties": {
    "task_id": { "type": "string" },
    "session_id": { "type": "string" },
    "target_id": { "type": "string" },
    "assigned_agent": { "type": "string" },
    "task_type": {
      "type": "string",
      "enum": ["check_env", "recon", "dns_enum", "http_probe", "crawl", "vuln_scan", "validate_finding", "risk_analysis", "generate_report"]
    },
    "status": {
      "type": "string",
      "enum": ["pending", "in_progress", "completed", "failed", "blocked_by_policy", "cancelled"]
    },
    "parameters": { "type": "object" },
    "result": { "type": "object" },
    "error": { "type": ["string", "null"] },
    "created_at": { "type": "string", "format": "date-time" },
    "completed_at": { "type": ["string", "null"], "format": "date-time" }
  }
}
