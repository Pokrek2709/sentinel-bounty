{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SentinelBountyAsset",
  "type": "object",
  "required": ["asset_id", "session_id", "target_id", "asset_type", "asset_value", "discovered_at"],
  "properties": {
    "asset_id": { "type": "string" },
    "session_id": { "type": "string" },
    "target_id": { "type": "string" },
    "asset_type": {
      "type": "string",
      "enum": ["domain", "subdomain", "ip", "url", "endpoint"]
    },
    "asset_value": { "type": "string" },
    "resolved_ips": {
      "type": "array",
      "items": { "type": "string" },
      "default": []
    },
    "http_status": { "type": ["integer", "null"] },
    "title": { "type": ["string", "null"] },
    "technologies": {
      "type": "array",
      "items": { "type": "string" },
      "default": []
    },
    "response_headers": {
      "type": "object"
    },
    "discovery_tool": { "type": "string" },
    "discovered_at": { "type": "string", "format": "date-time" },
    "metadata": { "type": "object" }
  }
}
