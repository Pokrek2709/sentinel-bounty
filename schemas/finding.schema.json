{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SentinelBountyFinding",
  "type": "object",
  "required": [
    "finding_id",
    "session_id",
    "target_id",
    "asset_id",
    "title",
    "vulnerability_type",
    "severity",
    "confidence",
    "validation_status",
    "description",
    "steps_to_reproduce",
    "impact",
    "remediation"
  ],
  "properties": {
    "finding_id": { "type": "string" },
    "session_id": { "type": "string" },
    "target_id": { "type": "string" },
    "asset_id": { "type": "string" },
    "asset_url": { "type": "string" },
    "title": { "type": "string" },
    "vulnerability_type": { "type": "string" },
    "cwe_id": { "type": "string" },
    "severity": {
      "type": "string",
      "enum": ["critical", "high", "medium", "low", "informational"]
    },
    "cvss_vector": { "type": "string" },
    "cvss_score": { "type": "number", "minimum": 0, "maximum": 10 },
    "confidence": {
      "type": "string",
      "enum": ["confirmed", "potential", "false_positive", "needs_manual_review"]
    },
    "validation_status": {
      "type": "string",
      "enum": ["detected", "needs_review", "validated", "false_positive", "duplicate", "rejected"]
    },
    "description": { "type": "string" },
    "steps_to_reproduce": {
      "type": "array",
      "items": { "type": "string" }
    },
    "proof_of_concept": { "type": "string" },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "request": { "type": "string" },
          "response": { "type": "string" },
          "notes": { "type": "string" }
        }
      }
    },
    "impact": { "type": "string" },
    "remediation": { "type": "string" },
    "references": {
      "type": "array",
      "items": { "type": "string" }
    },
    "discovery_tool": { "type": "string" },
    "created_at": { "type": "string", "format": "date-time" }
  }
}
