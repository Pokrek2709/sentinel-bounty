{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SentinelBountyFinding",
  "type": "object",
  "required": [
    "finding_id",
    "session_id",
    "target_id",
    "asset_id",
    "title",
    "vulnerability_type",
    "severity",
    "confidence",
    "validation_status",
    "description",
    "steps_to_reproduce",
    "impact",
    "remediation"
  ],
  "properties": {
    "finding_id": { "type": "string" },
    "session_id": { "type": "string" },
    "target_id": { "type": "string" },
    "asset_id": { "type": "string" },
    "asset_url": { "type": "string" },
    "title": { "type": "string" },
    "vulnerability_type": { "type": "string" },
    "cwe_id": { "type": "string" },
    "severity": {
      "type": "string",
      "enum": ["critical", "high", "medium", "low", "informational"]
    },
    "cvss_vector": { "type": "string" },
    "cvss_score": { "type": "number", "minimum": 0, "maximum": 10 },
    "cvss_temporal_score": { "type": "number", "minimum": 0, "maximum": 10 },
    "cvss_environmental_score": { "type": "number", "minimum": 0, "maximum": 10 },
    "confidence": {
      "type": "string",
      "enum": ["confirmed", "potential", "false_positive", "needs_manual_review"]
    },
    "validation_status": {
      "type": "string",
      "enum": ["detected", "needs_review", "validated", "false_positive", "duplicate", "rejected"]
    },
    "merged_from": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Finding ids this finding was merged from by the semantic dedup pass (src/analysis/validator.js semanticDedupeFindings). Present only on merged findings; singletons omit it. Includes the representative's own id, so the list is the complete member set."
    },
    "ai_verdict": {
      "type": "object",
      "description": "Advisory AI-model verdict attached by the pluggable verifier interface (src/analysis/ai-verdict.js). It NEVER overrides the rule-based verdict from the validator; the rule verdict stands and this field is recorded alongside it, labelled advisory in reports. Present only when a verifier was configured for the run.",
      "properties": {
        "verdict": { "type": "string", "enum": ["valid", "false_positive", "needs_evidence"] },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "reasons": { "type": "array", "items": { "type": "string" } },
        "error": { "type": "string", "description": "Set when the verifier threw or returned an invalid result; the verdict is then needs_evidence with confidence 0." }
      },
      "required": ["verdict", "confidence", "reasons"]
    },
    "ai_verdict_source": {
      "type": "string",
      "description": "Where the ai_verdict came from: 'stub' for the built-in stub verifier, 'inline' for a function passed programmatically, or the file basename of a loaded verifier module."
    },
    "description": { "type": "string" },
    "steps_to_reproduce": {
      "type": "array",
      "items": { "type": "string" }
    },
    "proof_of_concept": { "type": "string" },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "request": { "type": "string" },
          "response": { "type": "string" },
          "notes": { "type": "string" }
        }
      }
    },
    "impact": { "type": "string" },
    "remediation": { "type": "string" },
    "references": {
      "type": "array",
      "items": { "type": "string" }
    },
    "discovery_tool": { "type": "string" },
    "created_at": { "type": "string", "format": "date-time" }
  }
}
